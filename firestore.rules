rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /users/{userId} {
      // In this version of the app, we use local device IDs instead of Firebase Auth.
      // So we must allow unauthenticated reads/writes for profiles.
      allow read, write: if true;
    }

    match /system/globalStats {
      // Allow unauthenticated clients to read/update global stats
      allow read, write: if true;
    }
  }
}
